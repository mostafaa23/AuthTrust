# Copy this file to .env and fill it in locally. Never put real values in
# the code or in Git.

# --- AWS (for the Lambda/SES report-sending function) ---
AWS_REGION=us-east-1
# Do not put AWS_ACCESS_KEY_ID / SECRET here in production - use an IAM
# Role attached to EC2/Lambda instead.
SES_SENDER_EMAIL=reports@yourdomain.com

# --- Wily Core ---
WILY_LOG_LEVEL=INFO
WILY_RATE_LIMIT_RPS=10
WILY_WORDLISTS_DIR=./wordlists

# --- Optional integrations ---
INTERACTSH_SERVER=
BURP_IMPORT_ENABLED=false
